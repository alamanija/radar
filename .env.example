# Native client config. The app reads these from the process environment at
# runtime, falling back to the value baked in at compile time (release builds
# set them in .github/workflows/release.yml). Export them in your shell before
# `cargo run -p radar-app`; the app does not load a .env file itself.

# radar-server base URL. Defaults to http://127.0.0.1:8787.
RADAR_SERVER_URL=http://127.0.0.1:8787

# Clerk OAuth (public client, PKCE). Find the Frontend API URL in the Clerk
# dashboard under API keys, and the client id on the OAuth application you
# created (see radar-server/README.md). Both are required to sign in.
RADAR_CLERK_FRONTEND_API=https://your-instance.clerk.accounts.dev
RADAR_CLERK_CLIENT_ID=replace-me
