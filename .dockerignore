*.log

# Rust artefacts — always rebuilt fresh in the builder stage.
target
**/target

# Editor / OS noise.
.DS_Store
.idea
.vscode
*.swp

# Desktop app assets (fonts, icons). The manifest stays in the context
# because it is a workspace member; only the binary assets are dropped.
radar-app/assets

# Secrets and environment files. Never bake these into an image.
.env
.env.*
!.env.example
radar-server/.env
!radar-server/.env.example

# Git metadata.
.git
.gitignore
.github

# Docs and project-internal tooling that the binary doesn't need.
README.md
CLAUDE.md
LICENSE.md
.claude
